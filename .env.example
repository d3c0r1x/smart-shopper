# ── Telegram ────────────────────────────────────────────────────
# Токен бота от @BotFather. run_bot12.cmd читает ключи из корневого .env
# (TG_TOKEN, OPEN_ROUTER_KEY, OZON_KEY, YANDEX_MARKET_KEY) и подставляет их
# в переменные окружения автоматически — этот файл можно не заполнять.
SHOPPER_BOT_TOKEN=

# ── OpenRouter (бесплатные модели) ──────────────────────────────
# Ключ: https://openrouter.ai/keys. Без ключа бот работает в демо-режиме
# (mock-провайдер: валидные структурные ответы на эвристиках).
OPENROUTER_API_KEY=
# Ключ Mistral (https://console.mistral.ai): текст-задачи идут через
# Mistral-модели (mistral-small/medium/large-latest), OpenRouter — запасной.
MISTRAL_API_KEY=
# Дневной лимит бесплатных запросов: 50 — без вложений, 1000 — после
# разового пополнения от $10 (документация OpenRouter).
SHOPPER_DAILY_LLM_LIMIT=50
# Лимит запросов в минуту на :free-модели (документация OpenRouter).
SHOPPER_RATE_PER_MINUTE=20
# Профиль моделей: fast | quality (см. llm/gateway.py — реестр).
SHOPPER_LLM_PROFILE=quality

# ── Маркетплейсы ────────────────────────────────────────────────
# Демо-режим: 0 = реальные web-эндпоинты (нужен прокси), 1 = встроенный каталог.
SHOPPER_DEMO_MODE=1
# Опциональные официальные ключи (API продавца — для каталога не нужны,
# основной канал данных — публичные web-эндпоинты):
#OZON_CLIENT_ID=
#OZON_API_KEY=
#YM_API_KEY=
# Прокси для публичных эндпоинтов (антибот), например http://127.0.0.1:8888
#SHOPPER_PROXY=
#
# ── Канал 1: публичные JSON-эндпоинты самих сайтов (SPA) ─────────
# Адаптеры автоматически используют эндпоинты из captured/{ozon,yandex}.json
# (URL, заголовки и cookies 1-в-1 из реального браузерного запроса).
# Зафиксировать их с рабочего IP:
#     python tools/capture_endpoints.py --market ozon --query "маска для сна"
#     python tools/capture_endpoints.py --market yandex --query "маска для сна"
# Без capture-файлов адаптеры работают по документированным семействам
# composer-api (Ozon web+mobile) и web-версии (Яндекс, JSON-LD) — им нужен
# чистый IP или SHOPPER_PROXY, иначе антибот возвращает 307/403/капчу.

# ── Хранилище (MVP: SQLite) ─────────────────────────────────────
#SHOPPER_DB_PATH=shopper.db

# ── Mini App ────────────────────────────────────────────────────
# URL развёрнутого Mini App (https). Используется для web_app-кнопки.
#SHOPPER_MINIAPP_URL=

# ── HTTP-API (Mini App) ─────────────────────────────────────────
# Порт локального сервера; VITE_API_URL в Mini App указывает сюда.
#SHOPPER_API_PORT=8081
# Токен для продакшена: Mini App шлёт его в X-API-Token (VITE_API_TOKEN).
#SHOPPER_API_TOKEN=
# Анонимный user_id из query при невалидном initData (только для разработки).
#SHOPPER_API_ALLOW_ANON=1
